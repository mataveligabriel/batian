{$BASTION_DOMAIN}

encode gzip

handle /api/* {
	reverse_proxy 127.0.0.1:8001
}

handle {
	root * /srv
	# index.html sempre revalidado: navegador e o app do Windows (Nativefier) pegam a versão nova logo após o deploy
	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@page not path /static/*
	header @page Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
