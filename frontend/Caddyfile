# BASTION_DOMAIN = endereço principal (domínio -> HTTPS automático via Let's Encrypt)
# BASTION_ALT    = endereço extra opcional (ex.: http://IP_DO_VPS para o app do Windows antigo continuar funcionando)
{$BASTION_DOMAIN} {$BASTION_ALT}

encode gzip

handle /api/* {
	reverse_proxy 127.0.0.1:8001
}

handle {
	root * /srv
	# index.html sempre revalidado: navegador e o app do Windows (Nativefier) pegam a versão nova logo após o deploy
	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@page not path /static/*
	header @page Cache-Control "no-cache"
	# service worker do PWA: sempre revalidado para o celular pegar a versão nova
	header /sw.js Service-Worker-Allowed "/"
	try_files {path} /index.html
	file_server
}
