PUBLIC_URL=https://bastion.seudominio.com
BASTION_DOMAIN=bastion.seudominio.com
# opcional: segundo endereço aceito (ex.: http://IP_DO_VPS enquanto migra para o domínio)
BASTION_ALT=
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=bastion
JWT_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=TROQUE_ESTA_SENHA
CORS_ORIGINS=https://bastion.seudominio.com
TUNNEL_BIND_HOST=127.0.0.1
SEED_SAMPLE_DATA=false
# Acesso Web (páginas http/https dos equipamentos): portas usadas pelo Bastion — libere no firewall
WEB_PROXY_PORTS=8090-8099
WEB_PROXY_IDLE_MIN=30
# HTTPS opcional, junto com o endereço atual (voz/microfone, Acesso Web dentro do app). IP ou domínio — README seção 22
#BASTION_HTTPS_HOST=IP_OU_DOMINIO
#BASTION_HTTPS_PORT=8443
# RPKI (menu RPKI): ativado pelo deploy/rpki-setup.sh, que preenche as linhas abaixo — README seção 26
#COMPOSE_PROFILES=rpki
#KRILL_ADMIN_TOKEN=
#KRILL_URL=https://127.0.0.1:3000
# Área de Trabalho Remota: imagem do guacd (README seção 28). Não exponha a porta 4822.
#GUACD_IMAGE=guacamole/guacd:1.5.5
